{
  "name": "@red-cup-engineering/news-property",
  "version": "0.2.0",
  "type": "module",
  "description": "News property site renderer and public artifact builder from a property record and editorial corpus.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "news-property-build": "./scripts/build-property.mjs"
  },
  "exports": {
    "./build": "./src/build.mjs",
    "./distribute": "./src/distribute.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "for f in src/*.mjs src/*/*.mjs scripts/*.mjs; do [ -e \"$f\" ] || continue; node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@red-cup-engineering/computer-serialized-content-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-inference-engine": "workspace:*",
    "@red-cup-engineering/computer-text-content-engineering-services-section": "workspace:*",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/html-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-triplet-serialized-content-engineering-services-section": "workspace:*",
    "@red-cup-engineering/web-theming-service": "workspace:*",
    "sharp": "0.35.4"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "package.json"
  ]
}
